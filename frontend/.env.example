# Express backend URL. Use http://localhost:3001 for local development.
VITE_API_BASE_URL=http://localhost:3001

# Supabase Auth is used only for the owner publishing and inbox screens.
# The publishable key is safe for frontend use; never add the Supabase secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
